<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys Xcode's GENERATE_INFOPLIST_FILE cannot express live here; everything else
	  (usage descriptions, encryption flag, versions) is still generated from build settings
	  and merged on top of this file at build time.

	  CFBundleURLTypes registers the `spectrum://` scheme. Without it the OS has nothing to
	  hand `spectrum://auth-callback` to, so Supabase's email-confirmation and password-reset
	  links open a browser error instead of the app — the redirect was configured in code and
	  in the Supabase dashboard, but never claimed by the bundle.
	-->
	<!--
	  The UI is unlocalised English. Without these keys iOS considers the bundle localised for
	  whatever the device is set to, and every system-supplied string inside the app (Cancel,
	  Done, the search field, swipe-to-delete) came back in that language while the app's own
	  text stayed English. Declaring English as the only localisation keeps them consistent.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<false/>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>berkay.Spectrum.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>spectrum</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
